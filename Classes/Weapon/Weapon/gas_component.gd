class_name GasComponent
extends Node

# ============================================================
# 导气组件
# 功能：模拟导气式自动武器的"导气孔→导气管→活塞"延时。
#       子弹经过导气孔时，部分高压燃气被引入推动活塞，
#       活塞再推动枪机框向后运动。
# 依赖：WeaponConfig（需要 barrel_length / muzzle_velocity）
# 说明：当前为简化实现，仅用一个比例系数估算延时。
#       后续可加入导气孔位置（导气箍）的精确计算。
# ============================================================

var config: WeaponConfig


# ============================================================
# 初始化
# ============================================================
func initialize(cfg: WeaponConfig) -> void:
	config = cfg
	print("GasComponent 初始化完成")


# ============================================================
# 导气延时计算
# ============================================================

## 计算从子弹经过导气孔到枪机开始后坐的延时
##
## 简化思路：
##   1. 子弹从弹膛飞到枪口的时间 ≈ barrel_length / muzzle_velocity
##   2. 导气孔通常在枪管的 1/3 处，燃气从导气孔传到活塞也需要时间
##   3. 取子弹总飞行时间的 30% 作为延时（粗略值）
##
## TODO：
##   - 从 config 读取导气孔位置（导气箍到弹膛的距离）
##   - 区分活塞短行程/长行程的延时差异
func get_delay_time() -> float:
	var barrel_time = config.barrel_length / config.muzzle_velocity
	return barrel_time * 0.3
