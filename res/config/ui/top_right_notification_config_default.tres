[gd_resource type="Resource" script_class="TopRightNotificationConfig" load_steps=12 format=3]

[ext_resource type="Script" path="res://Classes/ui/top_right_notification_config.gd" id="1_config"]
[ext_resource type="Script" path="res://Classes/ui/top_right_notification_entry.gd" id="2_entry"]
[ext_resource type="FontFile" path="res://res/fonts/ConflictCJKUI.ttf" id="3_font"]

[sub_resource type="Resource" id="Notification_movement"]
script = ExtResource("2_entry")
notification_id = &"tutorial_movement"
text = "前后左右移动"
symbol = "WASD"
visible = true
display_order = 10

[sub_resource type="Resource" id="Notification_free_camera"]
script = ExtResource("2_entry")
notification_id = &"tutorial_free_camera"
text = "进入自由视角"
symbol = "F"
visible = true
display_order = 20

[sub_resource type="Resource" id="Notification_free_camera_vertical"]
script = ExtResource("2_entry")
notification_id = &"tutorial_free_camera_vertical"
text = "（在自由视角内）上下移动"
symbol = "Q / E"
visible = true
display_order = 30

[sub_resource type="Resource" id="Notification_run_toggle"]
script = ExtResource("2_entry")
notification_id = &"tutorial_run_toggle"
text = "切换跑步/走路"
symbol = "Shift（单击）"
visible = true
display_order = 40

[sub_resource type="Resource" id="Notification_sprint"]
script = ExtResource("2_entry")
notification_id = &"tutorial_sprint"
text = "疾跑"
symbol = "Shift（长按）"
visible = true
display_order = 50

[sub_resource type="Resource" id="Notification_mouse_capture"]
script = ExtResource("2_entry")
notification_id = &"tutorial_mouse_capture"
text = "取消鼠标捕捉"
symbol = "ESC"
visible = true
display_order = 60

[sub_resource type="Resource" id="Notification_death_tests"]
script = ExtResource("2_entry")
notification_id = &"tutorial_death_tests"
text = "测试三种类型的死亡"
symbol = "T / Y / U"
visible = true
display_order = 70

[sub_resource type="Resource" id="Notification_quit"]
script = ExtResource("2_entry")
notification_id = &"tutorial_quit"
text = "目前关闭游戏的逻辑未完成，使用 ALT + F4 关闭"
symbol = "ALT + F4"
visible = true
display_order = 80

[resource]
script = ExtResource("1_config")
startup_notifications = Array[ExtResource("2_entry")]([SubResource("Notification_movement"), SubResource("Notification_free_camera"), SubResource("Notification_free_camera_vertical"), SubResource("Notification_run_toggle"), SubResource("Notification_sprint"), SubResource("Notification_mouse_capture"), SubResource("Notification_death_tests"), SubResource("Notification_quit")])
margin_right = 0.0
card_spacing = 4
startup_delay = 0.35
startup_stagger = 0.06
card_background = Color(0.035, 0.045, 0.06, 0.58)
card_corner_radius = 0
font = ExtResource("3_font")
metadata/_custom_type_script = "res://Classes/ui/top_right_notification_config.gd"
