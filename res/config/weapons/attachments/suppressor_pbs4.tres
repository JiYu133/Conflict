[gd_resource type="Resource" script_class="MuzzleDeviceConfig" format=3 uid="uid://pbs4_suppressor_01"]

[ext_resource type="Script" path="res://classes/weapon/weaponattachments/muzzle_device_config.gd" id="1_attcfg"]

[resource]
script = ExtResource("1_attcfg")

; ──────────────────────────── 基础信息 ────────────────────────────
attachment_name = "PBS-4 消音器"
; 枪口类型，装在 MUZZLE 槽
attachment_type = 1

; ──────────────────────────── 槽位约束 ────────────────────────────
allowed_slot = 1

; ──────────────────────────── 散布修正 ────────────────────────────
; 消音器增加重量，轻微提升稳定性，机瞄散布略减
hipfire_spread_modifier = -0.1
ads_spread_modifier = -0.05

; ──────────────────────────── 枪口物理 ────────────────────────────
gas_impulse_vector = Vector3(0, 0.05, 0.92)
gas_impulse_fraction = 0.9

; ──────────────────────────── 重量与机动 ────────────────────────────
; PBS-4 约 610 g
weight_kg = 0.61
center_of_mass_local = Vector3(0, 0, 0.12)
ads_speed_modifier = -0.1

; ──────────────────────────── 视野与光学 ────────────────────────────
magnification = 1.0
fov_override = -1.0
has_reticle = false

; ──────────────────────────── 特殊效果 ────────────────────────────
suppresses_flash = true
suppresses_sound = true
; PBS-4 配合亚音速弹可大幅降低枪声，普通弹药伤害不变
damage_modifier = 0.0
; 消音器长度约 255 mm，增加射线检测距离
length_modifier = 0.255
