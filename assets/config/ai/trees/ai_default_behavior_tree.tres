[gd_resource type="BehaviorTree" format=3]

; AIPlayer 默认 LimboAI 行为树。
; 在 LimboAI 编辑器中打开此资源即可替换、扩展或拆分任务。
; 当前根任务负责把 LimboAI 的生命周期 tick 转发给项目战术执行层。

[ext_resource type="Script" path="res://classes/bot/limbo/limbo_bot_tick.gd" id="1_task"]

[sub_resource type="BTAction" id="BTAction_ai_tick"]
script = ExtResource("1_task")

[resource]
root_task = SubResource("BTAction_ai_tick")
